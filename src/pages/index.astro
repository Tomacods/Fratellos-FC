---
import Base from '../layouts/Base.astro';
import Cuello from '../components/Cuello.astro';
import Pecho from '../components/Pecho.astro';
import Planilla from '../components/Planilla.astro';
import Plantel from '../components/Plantel.astro';
import Sponsors from '../components/Sponsors.astro';
import Estampa from '../components/Estampa.astro';
import Etiqueta from '../components/Etiqueta.astro';
import { club } from '../data/club';
---

<Base
  title={`${club.name} | ${club.nickname}, ${club.city}`}
  description="Sitio oficial de Fratellos Fútbol Club (El Frate), fútbol 7 de Comodoro Rivadavia. Campeón de la Serie B y la Serie A 2025 de la Comodoro Cup y representante argentino en la Liga de las Américas 2026 en Porto Alegre."
>
  <a href="#contenido" class="salto">Saltar al contenido</a>
  <Cuello />
  <main id="contenido">
    <Pecho />
    <Planilla />
    <Plantel />
    <Sponsors />
    <Estampa />
  </main>
  <Etiqueta />
</Base>

<style>
  .salto {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 4px;
    background: var(--naranja);
    color: var(--negro);
    font-weight: 700;
  }
  .salto:focus {
    top: 12px;
  }
</style>
