---
// Telas compartidas por todas las camisetas SVG de la página.
---

<svg class="telas" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="tela-rayas" width="9" height="10" patternUnits="userSpaceOnUse">
      <rect width="9" height="10" fill="#121110"></rect>
      <rect x="8" width="1" height="10" fill="#F4500A" fill-opacity="0.5"></rect>
    </pattern>
    <pattern id="tela-malla-blanca" width="8" height="14" patternUnits="userSpaceOnUse">
      <rect width="8" height="14" fill="#ffffff"></rect>
      <circle cx="2" cy="3.5" r="1" fill="#121110" fill-opacity="0.07"></circle>
      <circle cx="6" cy="10.5" r="1" fill="#121110" fill-opacity="0.07"></circle>
    </pattern>
    <pattern id="tela-malla-naranja" width="8" height="14" patternUnits="userSpaceOnUse">
      <rect width="8" height="14" fill="#F4500A"></rect>
      <circle cx="2" cy="3.5" r="1.05" fill="#7a2400" fill-opacity="0.22"></circle>
      <circle cx="6" cy="10.5" r="1.05" fill="#7a2400" fill-opacity="0.22"></circle>
    </pattern>
    <linearGradient id="tela-volumen" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#000" stop-opacity="0.38"></stop>
      <stop offset="0.2" stop-color="#000" stop-opacity="0"></stop>
      <stop offset="0.5" stop-color="#fff" stop-opacity="0.06"></stop>
      <stop offset="0.8" stop-color="#000" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#000" stop-opacity="0.38"></stop>
    </linearGradient>
    <linearGradient id="tela-pliegue" x1="0" x2="0.35" y1="0" y2="1">
      <stop offset="0" stop-color="#000" stop-opacity="0"></stop>
      <stop offset="0.45" stop-color="#000" stop-opacity="0.11"></stop>
      <stop offset="1" stop-color="#000" stop-opacity="0.05"></stop>
    </linearGradient>
  </defs>
</svg>

<style>
  .telas {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
