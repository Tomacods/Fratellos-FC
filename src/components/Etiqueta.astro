---
import { club } from '../data/club';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="tela-rib pb-16 pt-20" aria-labelledby="pie-titulo">
  <div class="mx-auto flex max-w-camiseta flex-col items-center px-4 sm:px-6">
    <div class="lavado">
      <span class="lavado__presilla" aria-hidden="true"></span>
      <img src="/img/escudo.jpg" alt="" width="56" height="56" class="lavado__escudo" />
      <p id="pie-titulo" class="lavado__club">Fratellos Fútbol Club</p>
      <p class="lavado__linea">Comodoro Rivadavia · Chubut · Patagonia Argentina</p>
      <p class="lavado__linea">Fútbol 7 competitivo · Patín artístico</p>
      <p class="lavado__linea lavado__linea--fuerte">Composición: 100% aguante</p>
      <span class="lavado__colores" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
      <p class="lavado__vamos">¡Vamos Frate!</p>
    </div>

    <nav aria-label="Pie" class="mt-12">
      <ul class="flex flex-wrap justify-center gap-x-7 gap-y-3">
        <li><a class="pie__link" href="#brasil">Brasil 2026</a></li>
        <li><a class="pie__link" href="#campana">Campaña</a></li>
        <li><a class="pie__link" href="#plantel">Plantel</a></li>
        <li><a class="pie__link" href="#sponsors">Sponsors</a></li>
        <li><a class="pie__link" href="#contacto">Contacto</a></li>
      </ul>
    </nav>

    <ul class="mt-8 flex flex-wrap justify-center gap-x-7 gap-y-3">
      <li>
        <a class="pie__ig" href={club.instagramUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="instagram" class="h-5 w-5" />
          {club.instagram}
        </a>
      </li>
      <li>
        <a class="pie__ig" href={club.patinUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="instagram" class="h-5 w-5" />
          @patin.fratellos
        </a>
      </li>
    </ul>

    <p class="mt-10 text-[0.8125rem] text-white/60">© {year} {club.name}</p>
  </div>
</footer>

<style>
  .lavado {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 6px;
    width: min(100%, 340px);
    padding: 40px 28px 30px;
    border-radius: 2px 2px 10px 10px;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.04), transparent 18%, transparent 82%, rgb(0 0 0 / 0.04)),
      repeating-linear-gradient(180deg, #ffffff 0 2px, #f4f4f2 2px 3px);
    color: var(--negro);
    text-align: center;
    box-shadow: 0 24px 40px -24px rgb(0 0 0 / 0.9);
  }

  .lavado::after {
    content: '';
    position: absolute;
    inset: 7px;
    border: 1.5px dashed rgb(18 17 16 / 0.35);
    border-radius: 2px 2px 7px 7px;
    pointer-events: none;
  }

  .lavado__presilla {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 64px;
    height: 20px;
    transform: translateX(-50%);
    border-radius: 3px;
    background: var(--naranja);
  }

  .lavado__escudo {
    width: 56px;
    height: 56px;
    border-radius: 999px;
    margin-bottom: 8px;
  }

  .lavado__club {
    font-family: 'Big Shoulders Display Variable', 'Arial Narrow', sans-serif;
    font-weight: 900;
    font-size: 1.75rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .lavado__linea {
    font-size: 0.8125rem;
    font-stretch: 88%;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }

  .lavado__linea--fuerte {
    margin-top: 6px;
    font-weight: 700;
    color: var(--negro);
  }

  .lavado__colores {
    display: flex;
    gap: 6px;
    margin-top: 10px;
  }

  .lavado__colores span {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(18 17 16 / 0.35);
  }

  .lavado__colores span:nth-child(1) {
    background: var(--naranja);
  }
  .lavado__colores span:nth-child(2) {
    background: var(--blanco);
  }
  .lavado__colores span:nth-child(3) {
    background: var(--negro);
  }

  .lavado__vamos {
    margin-top: 6px;
    font-family: 'Big Shoulders Display Variable', 'Arial Narrow', sans-serif;
    font-weight: 800;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--naranja-hondo);
  }

  .pie__link {
    font-family: 'Big Shoulders Display Variable', 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.8);
    text-decoration: none;
  }

  .pie__link:hover {
    color: var(--naranja);
  }

  .pie__ig {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--blanco);
    text-decoration: underline;
    text-decoration-color: rgb(244 80 10 / 0.8);
  }

  .pie__ig:hover {
    color: var(--naranja);
  }
</style>
